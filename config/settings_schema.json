[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FAF8F5",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#1C1917",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.india_commerce",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:info.india_commerce"
      },
      {
        "type": "text",
        "id": "default_country_of_origin",
        "label": "t:labels.default_country_of_origin",
        "default": "India"
      },
      {
        "type": "textarea",
        "id": "default_manufacturer",
        "label": "t:labels.default_manufacturer",
        "info": "t:info.default_manufacturer"
      },
      {
        "type": "textarea",
        "id": "customer_care",
        "label": "t:labels.customer_care",
        "info": "t:info.customer_care"
      },
      {
        "type": "textarea",
        "id": "grievance_officer",
        "label": "t:labels.grievance_officer",
        "info": "t:info.grievance_officer"
      },
      {
        "type": "text",
        "id": "payment_methods_text",
        "label": "t:labels.payment_methods_text"
      },
      {
        "type": "text",
        "id": "cod_note",
        "label": "t:labels.cod_note",
        "info": "t:info.cod_note"
      },
      {
        "type": "text",
        "id": "delivery_text",
        "label": "t:labels.delivery_text",
        "default": "Delivery in 3–7 days across India"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:labels.free_shipping_threshold",
        "info": "t:info.free_shipping_threshold"
      }
    ]
  }
]
