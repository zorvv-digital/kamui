{% doc %}
  Renders the store's enabled payment method icons and the payment methods text from theme settings.

  @param {string} [class] - Extra class for the wrapper

  @example
  {% render 'payment-icons' %}
  {% render 'payment-icons', class: 'footer__payments' %}
{% enddoc %}

<div class="payment-icons {{ class }}">
  <p class="visually-hidden">{{ 'footer.payment_methods' | t }}</p>

  {% if shop.enabled_payment_types.size > 0 %}
    <ul class="payment-icons__list" role="list">
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}</li>
      {% endfor %}
    </ul>
  {% endif %}

  {% if settings.payment_methods_text != blank %}
    <p class="payment-icons__text">{{ settings.payment_methods_text | escape }}</p>
  {% endif %}
</div>

{% stylesheet %}
  .payment-icons {
    display: grid;
    gap: var(--space-2);
  }
  .payment-icons__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .payment-icons__icon {
    width: 2.375rem;
    height: 1.5rem;
  }
  .payment-icons__text {
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }
{% endstylesheet %}
