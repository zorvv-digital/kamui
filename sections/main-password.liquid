<div class="password full-width">
  <div class="password__media" aria-hidden="true">
    <img src="{{ 'hero-desktop.webp' | asset_url }}" alt="" width="1774" height="887" fetchpriority="high">
  </div>

  <div class="password__panel">
    <span class="password__logo">{{ 'logo-kamui.svg' | inline_asset_content }}</span>
    <h1 class="page-title">{{ 'password.title' | t }}</h1>

    {% if shop.password_message != blank %}
      <p class="password__message">{{ shop.password_message | escape }}</p>
    {% endif %}

    {% form 'customer', class: 'password__signup' %}
      <input type="hidden" name="contact[tags]" value="newsletter,early-access">
      {% if form.posted_successfully? %}
        <p role="status">{{ 'sections.hero.subscribed' | t }}</p>
      {% else %}
        <p class="eyebrow">{{ 'sections.hero.subscribe_title' | t }}</p>
        <div class="password__field">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'sections.hero.email' | t }}"
            aria-label="{{ 'sections.hero.email' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit" aria-label="{{ 'sections.hero.subscribe' | t }}">
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
        {{ form.errors | default_errors }}
      {% endif %}
    {% endform %}

    {% form 'storefront_password', class: 'password__enter' %}
      <details
        {% if form.errors %}
          open
        {% endif %}
      >
        <summary>{{ 'password.enter_using_password' | t }}</summary>
        {% if form.errors %}
          <div role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
        <div class="password__field">
          <input
            id="PasswordInput"
            type="password"
            name="password"
            placeholder="{{ 'password.password' | t }}"
            autocomplete="current-password"
          >
          <button type="submit">{{ 'password.enter' | t }}</button>
        </div>
      </details>
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .password {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: var(--space-6) var(--page-margin);
    color: #fff;
    background: var(--color-brand, #9f100c);
  }
  .password__media {
    position: absolute;
    inset: 0;
  }
  .password__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .password__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
  }
  .password__panel {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    width: min(30rem, 100%);
    text-align: center;
  }
  .password__logo svg {
    width: min(18rem, 70vw);
    height: auto;
  }
  .password__signup,
  .password__enter {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }
  .password__field {
    display: flex;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
  }
  .password__field:focus-within {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .password__field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    color: inherit;
  }
  .password__field input::placeholder {
    color: rgb(255 255 255 / 0.75);
  }
  .password__field button {
    min-width: var(--tap-target);
    padding-inline: var(--space-4);
    border: 0;
    background: none;
    color: inherit;
  }
  .password__enter summary {
    min-height: var(--tap-target);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    list-style: none;
    cursor: pointer;
  }
  .password__enter summary::-webkit-details-marker {
    display: none;
  }
  .password__enter details[open] summary {
    margin-block-end: var(--space-3);
  }
  .password :focus-visible {
    outline-color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
