{% liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
%}

{% paginate collection.products by 24 %}
  <div class="collection">
    <header class="collection__header">
      <h1 class="page-title">{{ collection.title | escape }}</h1>
      {% if collection.description != blank %}
        <div class="collection__description rte">{{ collection.description }}</div>
      {% endif %}
    </header>

    <form class="collection__toolbar" id="CollectionForm-{{ section.id }}" action="{{ collection.url }}" method="get">
      {% if collection.filters.size > 0 %}
        <button type="button" class="button collection__filter-toggle" popovertarget="FilterDrawer-{{ section.id }}">
          {{ 'collections.filter' | t }}
          {%- if active_count > 0 %} ({{ active_count }}){% endif %}
        </button>

        <div class="collection__filters" id="FilterDrawer-{{ section.id }}" popover>
          <div class="collection__drawer-header">
            <p class="eyebrow">{{ 'collections.filter' | t }}</p>
            <button
              type="button"
              class="collection__drawer-close"
              popovertarget="FilterDrawer-{{ section.id }}"
              popovertargetaction="hide"
            >
              {{ 'accessibility.close' | t }}
            </button>
          </div>

          {% for filter in collection.filters %}
            <details class="filter">
              <summary class="filter__summary">
                {{ filter.label | escape }}
                {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
              </summary>
              <div class="filter__panel">
                {% case filter.type %}
                  {% when 'price_range' %}
                    <div class="filter__price">
                      <label>
                        <span class="eyebrow">{{ 'collections.price_from' | t }}</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          {% if filter.min_value.value %}
                            value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                          {% endif %}
                          placeholder="0"
                          min="0"
                          inputmode="numeric"
                        >
                      </label>
                      <label>
                        <span class="eyebrow">{{ 'collections.price_to' | t }}</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          {% if filter.max_value.value %}
                            value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                          {% endif %}
                          placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"
                          min="0"
                          inputmode="numeric"
                        >
                      </label>
                    </div>
                  {% else %}
                    <ul class="filter__values" role="list">
                      {% for value in filter.values %}
                        <li>
                          <label class="filter__value{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >
                            <span>{{ value.label | escape }}</span>
                            <span class="filter__count">{{ value.count }}</span>
                          </label>
                        </li>
                      {% endfor %}
                    </ul>
                {% endcase %}
                <button type="submit" class="button button--primary filter__apply">{{ 'collections.apply' | t }}</button>
              </div>
            </details>
          {% endfor %}

          <div class="collection__drawer-footer">
            <a class="button" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
            <button type="submit" class="button button--primary">{{ 'collections.show_results' | t }}</button>
          </div>
        </div>
      {% endif %}

      <p class="collection__count">{{ 'collections.product_count' | t: count: collection.products_count }}</p>

      <sort-select class="collection__sort">
        <label class="eyebrow" for="SortBy-{{ section.id }}">{{ 'collections.sort' | t }}</label>
        <select id="SortBy-{{ section.id }}" name="sort_by">
          {% for option in collection.sort_options %}
            <option
              value="{{ option.value | escape }}"
              {% if option.value == sort_by %}
                selected
              {% endif %}
            >
              {{- option.name | escape -}}
            </option>
          {% endfor %}
        </select>
        <button type="submit" class="button" data-sort-submit>{{ 'collections.apply' | t }}</button>
      </sort-select>
    </form>

    {% if active_count > 0 %}
      <ul class="collection__chips" role="list">
        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <li>
              <a
                class="chip"
                href="{{ value.url_to_remove }}"
                aria-label="{{ 'collections.remove_filter' | t: label: value.label | escape }}"
              >
                {{- value.label | escape }} <span aria-hidden="true">&times;</span>
              </a>
            </li>
          {% endfor %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != nil or filter.max_value.value != nil %}
              {% capture price_label -%}
                {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }}
              {%- endcapture %}
              <li>
                <a
                  class="chip"
                  href="{{ filter.url_to_remove }}"
                  aria-label="{{ 'collections.remove_filter' | t: label: price_label | escape }}"
                >
                  {{- price_label }} <span aria-hidden="true">&times;</span>
                </a>
              </li>
            {% endif %}
          {% endif %}
        {% endfor %}
        <li>
          <a class="chip chip--clear" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
        </li>
      </ul>
    {% endif %}

    {% if collection.products.size > 0 %}
      <ul class="product-grid" role="list">
        {% for product in collection.products %}
          <li>
            {% if forloop.index <= 4 %}
              {% render 'product-card', product: product, eager: true, heading: 'h2' %}
            {% else %}
              {% render 'product-card', product: product, heading: 'h2' %}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {% else %}
      <div class="collection__empty">
        {% if active_count > 0 %}
          <p>{{ 'collections.empty_filtered' | t }}</p>
          <a class="button" href="{{ clear_url }}">{{ 'collections.clear_all' | t }}</a>
        {% else %}
          <p>{{ 'collections.empty' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'collections.view_all' | t }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endpaginate %}

{% stylesheet %}
  .collection {
    padding-block: var(--space-6) var(--space-section);
  }
  .collection__header {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-6);
    text-align: center;
  }
  .collection__description {
    color: var(--color-muted);
  }
  .collection__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
    padding-block: var(--space-3);
    border-block: 1px solid var(--color-rule);
  }
  .collection__filter-toggle,
  .collection__drawer-header,
  .collection__drawer-footer {
    display: none;
  }
  .collection__filters {
    position: static;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    overflow: visible;
  }
  .filter {
    position: relative;
  }
  .filter__summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-target);
    padding-inline: var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }
  .filter__summary::-webkit-details-marker {
    display: none;
  }
  .filter__summary::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    border-inline-end: 1px solid;
    border-block-end: 1px solid;
    rotate: 45deg;
    translate: 0 -0.15em;
    transition: rotate var(--duration-fast) var(--ease-out);
  }
  .filter[open] .filter__summary::after {
    rotate: -135deg;
    translate: 0 0.1em;
  }
  .filter__panel {
    position: absolute;
    z-index: 4;
    top: calc(100% + var(--space-2));
    left: 0;
    display: grid;
    gap: var(--space-4);
    min-width: 16rem;
    padding: var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-background);
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 0.08);
  }
  .filter__values {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .filter__value {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .filter__value.is-empty {
    color: var(--color-muted);
    cursor: not-allowed;
  }
  .filter__count {
    margin-inline-start: auto;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .filter__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .filter__price label {
    display: grid;
    gap: var(--space-1);
  }
  .filter__price input {
    width: 100%;
  }
  .collection__count {
    margin-inline-start: auto;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .collection__sort {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .collection__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-5);
    padding: 0;
    list-style: none;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: 0;
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .chip:hover {
    border-color: currentcolor;
  }
  .chip--clear {
    border-color: transparent;
    text-decoration: underline;
  }
  .collection__empty {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-7);
    text-align: center;
  }
  @media (max-width: 749px) {
    .collection__filter-toggle {
      display: inline-flex;
    }
    .collection__count {
      flex-basis: 100%;
      order: 3;
      margin: 0;
    }
    .collection__sort {
      margin-inline-start: auto;
    }
    .collection__sort label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .collection__filters {
      display: none;
    }
    .collection__filters:popover-open {
      position: fixed;
      inset: 0 0 0 auto;
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0;
      width: min(26rem, 100%);
      height: 100dvh;
      padding: var(--space-5);
      overflow-y: auto;
      background: var(--color-background);
    }
    .collection__filters::backdrop {
      background: rgb(0 0 0 / 0.5);
    }
    .collection__drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-block-end: var(--space-4);
    }
    .collection__drawer-close {
      min-height: var(--tap-target);
      border: 0;
      background: none;
      text-decoration: underline;
    }
    .collection__filters .filter {
      border-block-start: 1px solid var(--color-rule);
    }
    .collection__filters .filter__summary {
      justify-content: space-between;
      min-height: 3.25rem;
      padding-inline: 0;
    }
    .filter__panel {
      position: static;
      min-width: 0;
      padding: 0 0 var(--space-4);
      border: 0;
      box-shadow: none;
    }
    .filter__apply {
      display: none;
    }
    .collection__drawer-footer {
      position: sticky;
      bottom: calc(-1 * var(--space-5));
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
      margin-block-start: auto;
      padding-block: var(--space-4) var(--space-5);
      background: var(--color-background);
    }
  }
{% endstylesheet %}

{% javascript %}
  class SortSelect extends HTMLElement {
    connectedCallback() {
      const select = this.querySelector('select');
      this.querySelector('[data-sort-submit]')?.setAttribute('hidden', '');
      select.addEventListener('change', () => select.form.requestSubmit());
    }
  }

  if (!customElements.get('sort-select')) customElements.define('sort-select', SortSelect);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
