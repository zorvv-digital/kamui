{% liquid
  assign image_src = 'hero-desktop.webp' | asset_url
  assign image_alt = 'sections.hero.image_alt' | t

  # ponytail: one image size per breakpoint, add srcset widths if picked images load slowly
  if section.settings.image
    assign image_src = section.settings.image | image_url: width: 3840
    assign image_alt = section.settings.image.alt | default: image_alt
  endif
%}

{%- comment -%}
  Without a dedicated mobile image, phones show the whole wide photo at the top (hero--fit)
  instead of cropping it to a tall sliver.
{%- endcomment -%}
<div class="hero full-width{% unless section.settings.image_mobile %} hero--fit{% endunless %}">
  <div class="hero__media" style="--hero-image: url('{{ image_src }}')">
    <picture>
      {%- if section.settings.image_mobile -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 1500 }}"
        >
      {%- endif -%}
      <img
        src="{{ image_src }}"
        alt="{{ image_alt | escape }}"
        width="1535"
        height="1025"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
    <div class="hero__scrim"></div>

    <div class="hero__copy">
      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hero__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      <a class="hero__cta" href="#FooterSignup">
        {{- 'sections.hero.early_access' | t -}}
      </a>
    </div>
  </div>
</div>

{% comment %}
  The heading waits for its font (block, preloaded) instead of drawing in a wider fallback
  first, which reflowed the copy mid-animation.
{% endcomment %}
{{ section.settings.heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'block' }}

  .hero__heading,
  .hero__subheading,
  .hero__cta {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{% endstyle %}

{% stylesheet %}
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--announcement-height));
    margin-block-start: calc(-1 * var(--header-height));
  }
  .hero__media {
    position: relative;
    flex: 1;
    display: flex;
    align-items: flex-end;
    min-height: 24rem;
    padding: var(--header-height) max(var(--page-margin), 3vw) max(3.75rem, 6vw);
    overflow: hidden;
    background: var(--color-foreground);
    color: #fff;
  }
  .hero__media img {
    animation: hero-settle 1.8s var(--ease-out) both;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    /* Mirrored; transform keeps it separate from the settle animation's scale */
    transform: scaleX(-1);
  }
  /* Light dark-red tint on top of the pre-graded photo */
  .hero__media picture::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-brand) 60%, #000);
    mix-blend-mode: soft-light;
    opacity: 0.45;
  }
  @keyframes hero-settle {
    from {
      scale: 1.08;
    }
  }
  .hero__copy {
    position: relative;
    animation: hero-rise 1s var(--ease-out) 0.3s both;
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgb(0 0 0 / 0.45), transparent calc(var(--header-height) * 2)),
      linear-gradient(transparent 70%, rgb(0 0 0 / 0.2)),
      radial-gradient(ellipse at 55% 55%, transparent 40%, rgb(0 0 0 / 0.6));
  }
  /* Sized to stay in the empty left of the photo, clear of the figures */
  .hero__heading {
    margin-inline-start: -0.02em;
    font-size: clamp(6rem, 10.75vw, 18rem);
    line-height: 1;
    word-spacing: -0.1em;
    text-transform: uppercase;
  }
  .hero__subheading {
    margin-block-start: 0.5rem;
    font-size: clamp(1rem, 1.5vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero__cta {
    display: inline-block;
    margin-block-start: 0.875rem;
    padding: 0.5rem 1rem;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-brand);
    color: #fff;
    font-size: clamp(0.8125rem, 0.875vw, 1.125rem);
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .hero__cta:hover {
    background: #fff;
    color: var(--color-brand);
  }
  /* The mobile crop has no empty side, so the copy sits on the figure */
  @media (max-width: 749px) {
    .hero__heading {
      font-size: 26vw;
    }
    .hero__scrim {
      background:
        linear-gradient(
          rgb(0 0 0 / 0.45),
          transparent calc(var(--header-height) * 2),
          transparent 55%,
          rgb(0 0 0 / 0.55)
        ),
        radial-gradient(ellipse at 50% 50%, transparent 40%, rgb(0 0 0 / 0.55));
    }
    /* Wide group photo on a tall screen: keep everyone in frame at the top and fade it into the dark,
       with the copy below, rather than cropping to a sliver */
    /* Photo and copy stack at the bottom of the full-height hero; spare height on tall phones
       becomes dark space under the header, which the photo's top edge fades into */
    .hero--fit .hero__media {
      flex-direction: column;
      justify-content: flex-end;
      align-items: stretch;
      padding-block-start: 0;
    }
    .hero--fit .hero__media picture {
      position: relative;
      flex: none;
      align-self: center;
      width: 100vw;
      max-width: none;
      height: calc(100vw / 1.05);
      margin-block-end: -4.5rem;
      mask-image: linear-gradient(transparent, #000 12%, #000 65%, transparent);
    }
    /* A blurred, darkened copy of the photo fills the rest of the screen, so the spare space glows instead of sitting flat black */
    .hero--fit .hero__media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--hero-image) center / cover;
      filter: blur(28px) brightness(0.65);
      transform: scale(1.2) scaleX(-1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:labels.heading"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "t:labels.heading_font",
      "default": "anton_n4"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
