{% liquid
  assign image_src = 'hero-desktop.webp' | asset_url
  assign image_mobile_src = 'hero-mobile.webp' | asset_url
  assign image_alt = 'sections.hero.image_alt' | t

  # ponytail: one image size per breakpoint, add srcset widths if picked images load slowly
  if section.settings.image
    assign image_src = section.settings.image | image_url: width: 3840
    assign image_mobile_src = image_src
    assign image_alt = section.settings.image.alt | default: image_alt
  endif

  if section.settings.image_mobile
    assign image_mobile_src = section.settings.image_mobile | image_url: width: 1500
  endif
%}

<div class="hero full-width">
  <div class="hero__media">
    <picture>
      <source media="(max-width: 749px)" srcset="{{ image_mobile_src }}">
      <img
        src="{{ image_src }}"
        alt="{{ image_alt | escape }}"
        width="1774"
        height="887"
        loading="eager"
        fetchpriority="high"
      >
    </picture>
    <div class="hero__scrim"></div>

    {% if section.settings.heading != blank %}
      <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
  </div>

  <div class="hero__subscribe">
    <p>{{ 'sections.hero.subscribe_title' | t }}</p>

    {% form 'customer', class: 'hero__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,early-access">

      {% if form.posted_successfully? %}
        <p role="status">{{ 'sections.hero.subscribed' | t }}</p>
      {% else %}
        <div class="hero__field">
          <input
            type="email"
            name="contact[email]"
            placeholder="{{ 'sections.hero.email' | t }}"
            aria-label="{{ 'sections.hero.email' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit" aria-label="{{ 'sections.hero.subscribe' | t }}">
            <span aria-hidden="true">&rarr;</span>
          </button>
        </div>
        {{ form.errors | default_errors }}
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--announcement-height));
    margin-block-start: calc(-1 * var(--header-height));
  }
  .hero__media {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 24rem;
    padding: var(--header-height) max(var(--page-margin), 3vw) 0;
    overflow: hidden;
    background: var(--color-brand);
    color: #fff;
  }
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scrim {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--header-height) * 2);
    background: linear-gradient(rgb(0 0 0 / 0.45), transparent);
  }
  .hero__heading {
    position: relative;
    max-width: 14em;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero__subscribe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem var(--page-margin);
    border-block-end: 1px solid rgb(0 0 0 / 0.15);
    text-align: center;
  }
  .hero__form {
    width: min(28rem, 100%);
  }
  .hero__field {
    display: flex;
    border: 1px solid currentcolor;
    border-radius: var(--style-border-radius-inputs);
  }
  .hero__field:focus-within {
    outline: 2px solid currentcolor;
    outline-offset: 1px;
  }
  .hero__field input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 1rem;
    border: 0;
    outline: 0;
    background: none;
    color: inherit;
  }
  .hero__field button {
    padding-inline: 1rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  @media (max-width: 749px) {
    .hero__media img {
      object-position: 80% center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:labels.image_mobile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
