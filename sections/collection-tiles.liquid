<div class="collection-tiles">
  {% for block in section.blocks %}
    {% liquid
      assign tile_collection = block.settings.collection
      assign tile_image = block.settings.image | default: tile_collection.featured_image
      assign tile_label = block.settings.label | default: tile_collection.title

      if tile_collection
        assign wrapper = 'a'
      else
        assign wrapper = 'div'
      endif
    %}

    <{{ wrapper }}
      class="collection-tile"
      {% if tile_collection %}
        href="{{ tile_collection.url }}"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      {% if tile_image %}
        {{
          tile_image
          | image_url: width: 1600
          | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1600', sizes: '(min-width: 750px) 40vw, 100vw'
        }}
      {% else %}
        {{ 'placeholder-tee.svg' | inline_asset_content }}
      {% endif %}

      {% if tile_label != blank %}
        <h3 class="collection-tile__label">{{ tile_label | escape }}</h3>
      {% endif %}
    </{{ wrapper }}>
  {% endfor %}
</div>

{% stylesheet %}
  .collection-tiles {
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: 1rem;
    padding-block-end: clamp(2.5rem, 6vw, 5rem);
  }
  .collection-tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(22rem, 38vw, 36rem);
    padding: clamp(1rem, 2vw, 1.75rem);
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: #fff;
    text-decoration: none;
  }
  .collection-tile > img,
  .collection-tile > svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.5s ease;
  }
  a.collection-tile {
    transition: scale var(--duration-fast) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  a.collection-tile:active {
    scale: 0.98;
  }
  a.collection-tile:hover > img {
    scale: 1.03;
  }
  .collection-tile:has(.collection-tile__label)::after {
    content: '';
    position: absolute;
    inset: 50% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.5));
  }
  .collection-tile__label {
    position: relative;
    z-index: 1;
    font-size: clamp(1rem, 1.6vw, 1.375rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  @media (max-width: 749px) {
    .collection-tiles {
      grid-template-columns: 1fr;
    }
    .collection-tile {
      min-height: 18rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_tiles",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "t:general.collection_card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
