{% liquid
  assign image_src = 'puzzle-kamui.webp' | asset_url
  if section.settings.image
    assign image_src = section.settings.image | image_url: width: 1800, height: 1200, crop: 'center'
  endif
  assign instructions_id = 'PuzzleInstructions-' | append: section.id
%}

<div class="puzzle full-width" data-puzzle>
  <p class="visually-hidden" id="{{ instructions_id }}">{{ 'sections.puzzle.instructions' | t }}</p>
  <p
    class="visually-hidden"
    aria-live="polite"
    data-status
    data-solved="{{ 'sections.puzzle.solved_message' | t }}"
  ></p>

  <div class="puzzle__inner">
    <kamui-jigsaw
      class="puzzle__stage"
      data-size="{{ section.settings.grid_size }}"
      data-image="{{ image_src }}"
      data-board-label="{{ 'sections.puzzle.board' | t }}"
      data-piece-label="{{ 'sections.puzzle.tile' | t: number: '__N__' }}"
      data-instructions="{{ instructions_id }}"
    >
      <img src="{{ image_src }}" alt="" width="1800" height="1200" loading="lazy">
    </kamui-jigsaw>
  </div>
</div>

{% stylesheet %}
  .puzzle {
    padding: var(--space-section) var(--page-margin);
    background: #fff;
  }
  .puzzle__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
  }
  .puzzle__stage {
    display: block;
    /* Whole board fits in one screen */
    width: min(100%, 56rem, (100svh - 14rem) * 1.5);
    aspect-ratio: 3 / 2;
  }
  .puzzle__stage > img {
    width: 100%;
    height: 100%;
  }
  .puzzle__stage svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    user-select: none;
  }
  .puzzle__base {
    fill: var(--color-foreground);
  }
  .puzzle__piece {
    touch-action: none;
    outline: none;
    transition: transform 0.3s var(--ease-out);
  }
  .puzzle__piece.is-movable {
    cursor: grab;
  }
  .puzzle__piece image {
    transition: opacity 0.6s var(--ease-out);
  }
  /* The empty slot: the missing piece drawn as a light outline under the others */
  .puzzle__piece.is-missing {
    pointer-events: none;
  }
  .puzzle__piece.is-missing image {
    opacity: 0;
  }
  .puzzle__piece.is-missing path {
    fill: color-mix(in srgb, var(--color-foreground) 10%, #fff);
    stroke: none;
  }
  .puzzle__piece path {
    fill: none;
    stroke: rgb(0 0 0 / 0.6);
    stroke-width: 1.5;
  }
  .puzzle__piece.is-dragging {
    cursor: grabbing;
    transition: none;
  }
  .puzzle__piece:focus-visible path {
    stroke: var(--color-brand);
    stroke-width: 5;
  }
  .puzzle.is-solved .puzzle__piece {
    pointer-events: none;
  }
  .puzzle.is-solved .puzzle__piece path {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
{% endstylesheet %}

{% javascript %}
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const CELL = 100;

  // One side of a piece from (x0,y0) to (x1,y1). tab is 1 (knob out), -1 (hole in) or 0 (flat).
  function edge(x0, y0, x1, y1, tab) {
    if (!tab) return ` L${x1},${y1}`;
    const dx = (x1 - x0) / CELL;
    const dy = (y1 - y0) / CELL;
    const point = (u, v) => `${x0 + dx * u + dy * v * tab},${y0 + dy * u - dx * v * tab}`;
    return (
      ` L${point(36, 0)}` +
      ` C${point(40, 0)} ${point(30, 22)} ${point(50, 22)}` +
      ` C${point(70, 22)} ${point(60, 0)} ${point(64, 0)}` +
      ` L${x1},${y1}`
    );
  }

  // Sliding jigsaw: the last piece is missing, and only pieces next to the gap can move into it.
  class KamuiJigsaw extends HTMLElement {
    connectedCallback() {
      // Rows from the setting; columns keep the board at roughly 3:2.
      this.rows = Number(this.dataset.size) || 4;
      this.cols = Math.round(this.rows * 1.5);
      this.section = this.closest('[data-puzzle]');
      this.observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          this.observer.disconnect();
          this.status = this.section.querySelector('[data-status]');
          this.reset();
        },
        { rootMargin: '200px' }
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }

    reset() {
      const n = this.cols;
      const rows = this.rows;
      const width = n * CELL;
      const height = rows * CELL;

      // Random tab direction for every inner edge, shared by the two pieces that meet there.
      const flip = () => (Math.random() < 0.5 ? 1 : -1);
      const across = Array.from({ length: rows }, () => Array.from({ length: n }, flip));
      const down = Array.from({ length: rows }, () => Array.from({ length: n }, flip));
      const path = (cell) => {
        const c = cell % n;
        const r = Math.floor(cell / n);
        const x = c * CELL;
        const y = r * CELL;
        return (
          `M${x},${y}` +
          edge(x, y, x + CELL, y, r > 0 ? -down[r - 1][c] : 0) +
          edge(x + CELL, y, x + CELL, y + CELL, c < n - 1 ? across[r][c] : 0) +
          edge(x + CELL, y + CELL, x, y + CELL, r < rows - 1 ? down[r][c] : 0) +
          edge(x, y + CELL, x, y, c > 0 ? -across[r][c - 1] : 0) +
          ' Z'
        );
      };

      const svg = document.createElementNS(SVG_NS, 'svg');
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('role', 'group');
      svg.setAttribute('aria-label', this.dataset.boardLabel);
      svg.setAttribute('aria-describedby', this.dataset.instructions);
      const uid = Math.random().toString(36).slice(2);

      const count = n * rows;
      let defs = '';
      for (let cell = 0; cell < count; cell++) {
        defs += `<clipPath id="jig-${uid}-${cell}"><path d="${path(cell)}"/></clipPath>`;
      }
      svg.innerHTML = `<defs>${defs}</defs><rect class="puzzle__base" width="${width}" height="${height}"/>`;

      // slots[piece] is where that piece sits now. The missing piece's slot is the gap.
      this.missing = count - 1;
      this.slots = Array.from({ length: count }, (_, i) => i);
      // Shuffle with random legal slides from the solved board, so it can always be solved.
      let previous = -1;
      for (let i = 0; i < count * 40 || this.isSolved(); i++) {
        const gap = this.slots[this.missing];
        const options = this.neighbours(gap).filter((slot) => slot !== previous);
        const slot = options[Math.floor(Math.random() * options.length)];
        this.slots[this.slots.indexOf(slot)] = gap;
        this.slots[this.missing] = slot;
        previous = gap;
      }

      this.pieces = this.slots.map((_, cell) => {
        const g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('class', 'puzzle__piece');
        g.innerHTML =
          `<image href="${this.dataset.image}" width="${width}" height="${height}" preserveAspectRatio="xMidYMid slice" clip-path="url(#jig-${uid}-${cell})"/>` +
          `<path d="${path(cell)}"/>`;
        const piece = { g, cell };
        if (cell === this.missing) {
          g.classList.add('is-missing');
          g.setAttribute('aria-hidden', 'true');
        } else {
          g.setAttribute('tabindex', '0');
          g.setAttribute('role', 'button');
          g.setAttribute('aria-label', this.dataset.pieceLabel.replace('__N__', cell + 1));
          g.addEventListener('pointerdown', (event) => this.grab(event, piece));
          g.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            this.slide(piece);
          });
        }
        // The missing piece sits first so every other piece draws over its light outline.
        if (cell === this.missing) svg.querySelector('.puzzle__base').after(g);
        else svg.append(g);
        return piece;
      });
      this.pieces.forEach((piece) => this.place(piece));
      this.refresh();

      this.svg?.remove();
      this.querySelector(':scope > img')?.remove();
      this.svg = svg;
      this.append(svg);
      this.status.textContent = '';
      this.section.classList.remove('is-solved');
    }

    neighbours(slot) {
      const n = this.cols;
      const c = slot % n;
      const r = Math.floor(slot / n);
      const list = [];
      if (c > 0) list.push(slot - 1);
      if (c < n - 1) list.push(slot + 1);
      if (r > 0) list.push(slot - n);
      if (r < this.rows - 1) list.push(slot + n);
      return list;
    }

    canMove(piece) {
      return this.neighbours(this.slots[this.missing]).includes(this.slots[piece.cell]);
    }

    isSolved() {
      return this.slots.every((slot, cell) => slot === cell);
    }

    refresh() {
      this.pieces.forEach((piece) => {
        if (piece.cell === this.missing) return;
        const movable = this.canMove(piece);
        piece.g.classList.toggle('is-movable', movable);
        piece.g.setAttribute('aria-disabled', String(!movable));
      });
    }

    place(piece, extra = { x: 0, y: 0 }) {
      const n = this.cols;
      const slot = this.slots[piece.cell];
      const x = ((slot % n) - (piece.cell % n)) * CELL + extra.x;
      const y = (Math.floor(slot / n) - Math.floor(piece.cell / n)) * CELL + extra.y;
      piece.g.style.transform = `translate(${x}px, ${y}px)`;
    }

    toSvg(event) {
      const point = new DOMPoint(event.clientX, event.clientY).matrixTransform(this.svg.getScreenCTM().inverse());
      return { x: point.x, y: point.y };
    }

    grab(event, piece) {
      if (this.section.classList.contains('is-solved') || !this.canMove(piece)) return;
      event.preventDefault();
      const n = this.cols;
      const from = this.slots[piece.cell];
      const gap = this.slots[this.missing];
      // Unit step towards the gap; the drag only travels along it, between here and the gap.
      const dir = { x: (gap % n) - (from % n), y: Math.floor(gap / n) - Math.floor(from / n) };
      const start = this.toSvg(event);
      let along = 0;
      let dragging = false;
      piece.g.setPointerCapture(event.pointerId);
      const move = (e) => {
        const point = this.toSvg(e);
        const dx = point.x - start.x;
        const dy = point.y - start.y;
        if (!dragging && Math.hypot(dx, dy) < 6) return;
        if (!dragging) {
          dragging = true;
          piece.g.classList.add('is-dragging');
        }
        along = Math.min(CELL, Math.max(0, dx * dir.x + dy * dir.y));
        this.place(piece, { x: dir.x * along, y: dir.y * along });
      };
      const up = () => {
        piece.g.removeEventListener('pointermove', move);
        piece.g.removeEventListener('pointerup', up);
        piece.g.removeEventListener('pointercancel', up);
        piece.g.classList.remove('is-dragging');
        if (!dragging || along > CELL * 0.3) this.slide(piece);
        else this.place(piece);
      };
      piece.g.addEventListener('pointermove', move);
      piece.g.addEventListener('pointerup', up);
      piece.g.addEventListener('pointercancel', up);
    }

    slide(piece) {
      if (this.section.classList.contains('is-solved') || !this.canMove(piece)) return;
      [this.slots[piece.cell], this.slots[this.missing]] = [this.slots[this.missing], this.slots[piece.cell]];
      this.place(piece);
      this.place(this.pieces[this.missing]);
      this.refresh();
      if (this.isSolved()) {
        this.section.classList.add('is-solved');
        this.pieces[this.missing].g.classList.remove('is-missing');
        this.status.textContent = this.status.dataset.solved;
      }
    }
  }

  if (!customElements.get('kamui-jigsaw')) customElements.define('kamui-jigsaw', KamuiJigsaw);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.puzzle",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "grid_size",
      "label": "t:labels.grid_size",
      "options": [
        { "value": "3", "label": "t:options.grid_size.three" },
        { "value": "4", "label": "t:options.grid_size.four" }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "t:general.puzzle"
    }
  ]
}
{% endschema %}
