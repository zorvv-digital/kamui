<div id="our-journey" class="journey">
  {% if section.settings.heading != blank %}
    <h2 class="journey__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  <div class="journey__grid">
    <div class="journey__media">
      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 750px) 50vw, 100vw'
        }}
      {% else %}
        {{ 'placeholder-scene.svg' | inline_asset_content }}
      {% endif %}
    </div>

    {% if section.settings.story != blank %}
      <div class="journey__story">{{ section.settings.story }}</div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .journey {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    border-block-start: 1px solid var(--color-rule);
  }
  .journey__heading {
    margin-block-end: clamp(1.5rem, 4vw, 3rem);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }
  .journey__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 5rem);
  }
  .journey__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
  }
  .journey__media img,
  .journey__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .journey__story {
    display: grid;
    gap: 1rem;
    max-width: 32rem;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.6;
  }
  @media (max-width: 749px) {
    .journey__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.journey",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Our journey"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "t:labels.story",
      "default": "<p>Kamui started with a simple idea: clothes worth wearing on repeat. Tell your story here, from the first sketch to the finished piece.</p>"
    }
  ],
  "presets": [
    {
      "name": "t:general.journey"
    }
  ]
}
{% endschema %}
