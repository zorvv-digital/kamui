{% liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact'
  assign announcement_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign announcement_count = announcement_count | plus: 1
    endif
  endfor
%}

{% if announcement_count > 0 %}
  <div
    class="announcement full-width{% if announcement_count > 1 %} announcement--ticker{% endif %}"
    role="region"
    aria-label="{{ 'header.announcements' | t }}"
  >
    {% comment %} The second copy makes the ticker loop without a gap. It is hidden from assistive tech. {% endcomment %}
    {% for copy in (1..2) %}
      {% if copy == 2 and announcement_count == 1 %}
        {% break %}
      {% endif %}
      <ul
        class="announcement__track"
        role="list"
        {% if copy == 2 %}
          aria-hidden="true"
        {% endif %}
      >
        {% for block in section.blocks %}
          {% if block.settings.text == blank %}
            {% continue %}
          {% endif %}
          <li
            {% if copy == 1 %}
              {{ block.shopify_attributes }}
            {% endif %}
          >
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                {% if copy == 2 %}
                  tabindex="-1"
                {% endif %}
              >
                {{- block.settings.text | escape -}}
              </a>
            {% else %}
              {{ block.settings.text | escape }}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endfor %}
  </div>
{% else %}
  {% style %}
    :root {
      --announcement-height: 0px;
    }
  {% endstyle %}
{% endif %}

<header class="header full-width">
  <a class="header__contact" href="{{ contact_url }}">
    <span aria-hidden="true">+</span>
    {{ 'header.contact' | t }}
  </a>

  <a class="header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
    {{ 'logo-kamui.svg' | inline_asset_content }}
  </a>

  <div class="header__icons">
    <button type="button" class="header__icon menu-toggle" popovertarget="header-menu">
      <svg class="menu-toggle__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path stroke="currentColor" d="M3 7h14" />
        <path stroke="currentColor" d="M3 13h14" />
      </svg>
      <span class="header__label">
        <span class="menu-toggle__open">{{ 'header.menu' | t }}</span>
        <span class="menu-toggle__close">{{ 'header.close' | t }}</span>
      </span>
    </button>

    {% comment %} The search icon is the field's label: pressing it focuses the field, and focus expands it. {% endcomment %}
    <form
      class="header__search"
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      data-suggest-url="{{ routes.predictive_search_url }}"
    >
      <label class="header__icon" for="HeaderSearch">
        {{ 'icon-search.svg' | inline_asset_content }}
        <span class="header__label">{{ 'header.search' | t }}</span>
      </label>
      <div class="header__search-panel">
        {{ 'icon-search.svg' | inline_asset_content }}
        <input
          id="HeaderSearch"
          type="search"
          name="q"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
          autocapitalize="off"
          enterkeyhint="search"
          aria-controls="HeaderSearchResults"
        >
        <button type="button" class="header__search-close" aria-label="{{ 'header.close' | t }}" data-search-close>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path stroke="currentColor" stroke-width="1.25" d="M4 4l12 12M16 4L4 16" />
          </svg>
        </button>
      </div>
      <input type="hidden" name="options[prefix]" value="last">
      <div class="header__results" id="HeaderSearchResults" data-predictive hidden></div>
      <p class="visually-hidden" role="status" data-predictive-status></p>
    </form>

    {% if shop.customer_accounts_enabled %}
      <a class="header__icon" href="{{ routes.account_url }}">
        {{ 'icon-account.svg' | inline_asset_content }}
        <span class="header__label">{{ 'header.account' | t }}</span>
      </a>
    {% endif %}

    <a class="header__icon" href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
      <span class="header__label">{{ 'header.cart' | t }}</span>
    </a>
  </div>

  {% comment %}
    The menu drops down from under the header (a script sets --menu-top on open), so the header's
    menu icon stays visible and turns into the close button. Its own close row only shows when the
    header has scrolled out of view.
  {% endcomment %}
  <nav id="header-menu" class="menu" popover aria-label="{{ 'header.menu' | t }}">
    <div class="menu__panel">
    <div class="menu__top">
      <span class="eyebrow">{{ 'header.menu' | t }}</span>
      <button type="button" class="menu__close" popovertarget="header-menu" popovertargetaction="hide">
        {{ 'header.close' | t }}
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-width="1.25" d="M4 4l12 12M16 4L4 16" />
        </svg>
      </button>
    </div>

    <div class="menu__body">
      <ul class="menu__links" role="list">
        {% for link in section.settings.menu.links %}
          <li style="--i: {{ forloop.index0 }}">
            <a
              href="{{ link.url }}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{- link.title | escape -}}
            </a>
            {% if link.links.size > 0 %}
              <ul class="menu__sublinks" role="list">
                {% for child in link.links %}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% else %}
          <li style="--i: 0"><a href="{{ routes.all_products_collection_url }}">{{ 'header.shop_all' | t }}</a></li>
          <li style="--i: 1"><a href="{{ routes.collections_url }}">{{ 'header.collections' | t }}</a></li>
        {% endfor %}
      </ul>

      {% comment %}
        Plain tiles, not the product-card snippet: the card sets a view-transition-name,
        and the same product may already be on the page.
      {% endcomment %}
      {% assign menu_collection = section.settings.menu_collection | default: collections.all %}
      {% if menu_collection.products.size > 0 %}
        <ul class="menu__products" role="list">
          {% for product in menu_collection.products limit: 3 %}
            <li style="--i: {{ forloop.index0 | plus: 2 }}">
              <a href="{{ product.url }}">
                <div class="menu__photo">
                  {% if product.featured_image %}
                    {{
                      product.featured_image
                      | image_url: width: 600
                      | image_tag: loading: 'lazy', widths: '200, 300, 450, 600', sizes: '(min-width: 750px) 20vw, 30vw', alt: ''
                    }}
                  {% else %}
                    {{ 'placeholder-tee.svg' | inline_asset_content }}
                  {% endif %}
                </div>
                <span class="menu__product-title">{{ product.title | escape }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <ul class="menu__meta" role="list">
      <li><a href="{{ routes.search_url }}">{{ 'header.search' | t }}</a></li>
      {% if shop.customer_accounts_enabled %}
        <li><a href="{{ routes.account_url }}">{{ 'header.account' | t }}</a></li>
      {% endif %}
      <li>
        <a href="{{ routes.cart_url }}">
          {{ 'header.cart' | t }}
          {% if cart.item_count > 0 %}
            ({{ cart.item_count }})
          {% endif %}
        </a>
      </li>
      <li><a href="{{ contact_url }}">{{ 'header.contact' | t }}</a></li>
    </ul>
    </div>
  </nav>
</header>

{% stylesheet %}
  :root {
    --color-brand: #9f100c;
    --announcement-height: 2rem;
    --header-height: 6rem;
  }
  .announcement {
    display: flex;
    align-items: center;
    min-height: var(--announcement-height);
    overflow: hidden;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.75rem;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .announcement__track {
    display: flex;
    flex: none;
    justify-content: center;
    min-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }
  .announcement__track li {
    display: flex;
    align-items: center;
    padding-inline: var(--space-5);
  }
  .announcement__track a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .announcement .announcement__track a:focus-visible {
    outline-color: #fff;
  }
  .announcement--ticker .announcement__track {
    justify-content: space-around;
    animation: announcement-scroll 28s linear infinite;
  }
  .announcement--ticker .announcement__track li::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    margin-inline-end: calc(var(--space-5) * 2);
    background: currentcolor;
  }
  .announcement--ticker:focus-within .announcement__track {
    animation-play-state: paused;
  }
  @keyframes announcement-scroll {
    to {
      translate: -100% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .announcement--ticker {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .announcement--ticker .announcement__track {
      animation: none;
    }
    .announcement--ticker .announcement__track[aria-hidden] {
      display: none;
    }
  }

  /* Above the page, so the search results and menu icon are never covered by later sections. */
  .header {
    --icon-stroke-width: 1.25;
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-height);
    padding-inline: max(var(--page-margin), 3vw);
    color: var(--color-foreground);
    view-transition-name: site-header;
  }
  /* A hero slides underneath the header, see sections/hero.liquid */
  body:has(.hero) .header {
    color: #fff;
  }
  .header a,
  .header button {
    color: inherit;
    text-decoration: none;
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .header__logo svg {
    height: clamp(1.5rem, 2.6vw, 2.5rem);
    width: auto;
  }
  .header__icons {
    display: flex;
    justify-self: end;
    gap: 1.25rem;
  }
  .header .header__icon {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: var(--tap-target, 2.75rem);
    min-height: var(--tap-target, 2.75rem);
  }
  .header__icon svg {
    width: 1.5rem;
  }
  .header__icon sup {
    position: absolute;
    top: -0.25rem;
    left: calc(50% + 0.625rem);
    font-size: 0.6875rem;
  }
  .header__label {
    font-size: 0.6875rem;
  }

  /* Menu icon: the two lines rotate into an X while the menu is open. */
  .menu-toggle__icon path {
    stroke-width: var(--icon-stroke-width);
    transform-box: fill-box;
    transform-origin: center;
    transition: translate 0.35s var(--ease-out), rotate 0.35s var(--ease-out);
  }
  .header:has(.menu:popover-open) .menu-toggle__icon path:first-child {
    translate: 0 3px;
    rotate: 45deg;
  }
  .header:has(.menu:popover-open) .menu-toggle__icon path:last-child {
    translate: 0 -3px;
    rotate: -45deg;
  }
  .menu-toggle__close,
  .header:has(.menu:popover-open) .menu-toggle__open {
    display: none;
  }
  .header:has(.menu:popover-open) .menu-toggle__close {
    display: inline;
  }

  /* Menu: the page under the header dims, and a light panel unrolls downward from the header's edge. */
  .menu {
    inset: var(--menu-top, 0px) 0 0;
    width: 100%;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: rgb(0 0 0 / 0.45);
    color: var(--color-foreground);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out), overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  .menu::backdrop {
    background: transparent;
  }
  .menu__panel {
    max-height: calc(100dvh - var(--menu-top, 0px));
    padding: 0 max(var(--page-margin), 3vw);
    overflow-y: auto;
    border-block: 1px solid var(--color-rule);
    background: var(--color-background);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.5s var(--ease-out);
  }
  .menu:popover-open .menu__panel {
    clip-path: inset(0);
  }
  @starting-style {
    .menu:popover-open .menu__panel {
      clip-path: inset(0 0 100% 0);
    }
  }
  .menu:popover-open :is(.menu__links, .menu__products) > li {
    animation: menu-rise 0.5s var(--ease-out) backwards;
    animation-delay: calc(var(--i, 0) * 60ms + 120ms);
  }
  @keyframes menu-rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
  .menu__top {
    display: none;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    border-block-end: 1px solid var(--color-rule);
  }
  .menu--detached .menu__top {
    display: flex;
  }
  .header .menu__close {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-target);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .menu__close svg {
    width: 1.125rem;
  }
  .menu__body {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) minmax(0, 2fr);
    align-items: start;
    gap: var(--space-6);
    padding-block: var(--space-6);
  }
  .menu__links,
  .menu__sublinks,
  .menu__products,
  .menu__meta {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu__links > li > a {
    display: inline-flex;
    align-items: center;
    min-height: 3.25rem;
    font-size: var(--text-2xl);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .header .menu__links a:is(:hover, [aria-current]),
  .header .menu__meta a:hover,
  .header .menu__products a:hover .menu__product-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .menu__sublinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .menu__sublinks a,
  .menu__meta a {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .menu__products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .menu__products a {
    display: grid;
    gap: var(--space-2);
  }
  .menu__photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .menu__photo :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease-out);
  }
  .menu__products a:hover .menu__photo img {
    scale: 1.04;
  }
  .menu__product-title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .menu__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    padding-block: var(--space-2);
    border-block-start: 1px solid var(--color-rule);
  }

  /*
    Search: the icon is the field's label. Focus reveals a panel that wipes in from the icon side
    (clip-path, so the text never squashes). Desktop: a box beside the icons. Phones: the whole header row.
  */
  .header__search {
    position: relative;
    display: flex;
  }
  .header__search label {
    cursor: pointer;
  }
  .header__search-panel {
    position: absolute;
    top: 50%;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: min(20rem, 28vw);
    height: 3rem;
    padding-inline-start: var(--space-4);
    border: 1px solid var(--color-foreground);
    background: var(--color-background);
    color: var(--color-foreground);
    clip-path: inset(0 0 0 100%);
    opacity: 0;
    pointer-events: none;
    translate: 0 -50%;
    /* Closing: a quick fade, then the clip resets so the next open wipes in again. */
    transition: opacity var(--duration-fast) var(--ease-out), clip-path 0s linear var(--duration-fast);
  }
  .header__search:focus-within .header__search-panel,
  .header__search:has(input[type='search']:not(:placeholder-shown)) .header__search-panel {
    clip-path: inset(0);
    opacity: 1;
    pointer-events: auto;
    transition: clip-path 0.45s var(--ease-out);
  }
  .header__search-panel > svg {
    flex: none;
    width: 1.25rem;
  }
  .header__search-panel input[type='search'] {
    flex: 1;
    min-width: 0;
    min-height: 0;
    height: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: none;
    color: inherit;
    font-size: max(16px, var(--text-base));
    -webkit-appearance: none;
    appearance: none;
  }
  .header__search-panel input::-webkit-search-cancel-button {
    display: none;
  }
  .header__search-panel input::placeholder {
    color: var(--color-muted);
  }
  /* Live results under the search panel. */
  .header__results {
    position: absolute;
    top: calc(50% + 1.5rem - 1px);
    right: 0;
    z-index: 2;
    width: min(26rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 10rem);
    overflow-y: auto;
    border: 1px solid var(--color-foreground);
    background: var(--color-background);
    color: var(--color-foreground);
    animation: results-in 0.25s var(--ease-out);
  }
  @keyframes results-in {
    from {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
  .header .header__search-close {
    display: grid;
    flex: none;
    place-items: center;
    width: var(--tap-target);
    height: 100%;
  }
  .header__search-close svg {
    width: 1.125rem;
  }

  @media (max-width: 749px) {
    :root {
      --header-height: 4.5rem;
    }
    .header {
      grid-template-columns: 1fr auto;
    }
    .header__contact {
      display: none;
    }
    .header__icons {
      gap: 0;
    }
    .header__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .menu__body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding-block: var(--space-5);
    }
    .menu__products {
      gap: var(--space-2);
    }
    .header__search {
      position: static;
    }
    .header__results {
      top: 100%;
      right: 0;
      left: 0;
      width: auto;
      border-inline: 0;
    }
    .header__search-panel {
      inset: 0;
      width: auto;
      height: auto;
      padding-inline: max(var(--page-margin), 3vw) var(--space-2);
      border: 0;
      border-block-end: 1px solid var(--color-rule);
      translate: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Live search: fetch product suggestions as the shopper types (Shopify predictive search,
  // rendered by sections/predictive-search.liquid).
  (() => {
    const form = document.querySelector('.header__search');
    if (!form) return;
    const input = form.querySelector('input[type="search"]');
    const results = form.querySelector('[data-predictive]');
    const status = form.querySelector('[data-predictive-status]');
    let timer;
    let controller;

    const close = () => {
      results.hidden = true;
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      controller?.abort();
      const terms = input.value.trim();
      if (!terms) {
        results.innerHTML = '';
        status.textContent = '';
        close();
        return;
      }
      timer = setTimeout(async () => {
        controller = new AbortController();
        const params = new URLSearchParams({
          q: terms,
          'resources[type]': 'product',
          'resources[limit]': '4',
          'resources[options][unavailable_products]': 'last',
          section_id: 'predictive-search',
        });
        try {
          const response = await fetch(`${form.dataset.suggestUrl}?${params}`, { signal: controller.signal });
          const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          const panel = doc.querySelector('.predictive');
          if (!panel || input.value.trim() !== terms) return;
          results.replaceChildren(panel);
          status.textContent = panel.dataset.count;
          results.hidden = false;
        } catch (error) {
          if (error.name !== 'AbortError') close();
        }
      }, 180);
    });

    input.addEventListener('focus', () => {
      if (results.childElementCount) results.hidden = false;
    });
    document.addEventListener('click', (event) => {
      if (!form.contains(event.target)) close();
    });
  })();

  // Menu: open just below the header so its icon stays visible; click on the dimmed area closes.
  (() => {
    const menu = document.getElementById('header-menu');
    if (!menu) return;
    menu.addEventListener('beforetoggle', (event) => {
      if (event.newState !== 'open') return;
      const top = Math.max(0, Math.round(menu.closest('.header').getBoundingClientRect().bottom));
      menu.style.setProperty('--menu-top', `${top}px`);
      menu.classList.toggle('menu--detached', top === 0);
    });
    menu.addEventListener('click', (event) => {
      if (event.target === menu) menu.hidePopover();
    });
  })();

  // Site-wide scroll reveal (this header is on every page). Styles are in critical.css.
  (() => {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const selector = [
      '.featured-products__header',
      '.featured-products__grid > li',
      '.product-grid > li',
      '.collection-tile',
      '.puzzle__inner',
      '.journey__heading',
      '.journey__grid > *',
      '.list-collections__grid > li',
      '.blog__grid > li',
    ].join(',');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          // Reveal the whole row together, including cards a swipe row keeps off-screen.
          const top = entry.boundingClientRect.top;
          const row = [...entry.target.parentElement.children].filter(
            (el) => el.classList.contains('reveal-pending') && Math.abs(el.getBoundingClientRect().top - top) < 40
          );
          for (const el of row) {
            observer.unobserve(el);
            el.classList.add('reveal-in');
            el.classList.remove('reveal-pending');
          }
        }
      },
      // The huge top margin counts anything scrolled past as visible, so a jump down the page never leaves items hidden.
      { rootMargin: '100000px 0px 0px 0px' }
    );
    for (const el of document.querySelectorAll(selector)) {
      if (el.getBoundingClientRect().top < innerHeight) continue;
      const index = [...el.parentElement.children].indexOf(el);
      el.style.setProperty('--reveal-delay', `${(index % 3) * 60}ms`);
      el.classList.add('reveal-pending');
      observer.observe(el);
    }
  })();

  document.addEventListener('click', (event) => {
    const close = event.target.closest('[data-search-close]');
    if (!close) return;
    const input = close.closest('form').querySelector('input[type="search"]');
    input.value = '';
    input.dispatchEvent(new Event('input'));
    document.activeElement?.blur();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && event.target.id === 'HeaderSearch') {
      event.target.value = '';
      event.target.dispatchEvent(new Event('input'));
      event.target.blur();
    }
  });
