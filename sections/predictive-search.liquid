{% comment %}
  Live search results for the header search. Not placed on any page: the header script fetches it
  through the Section Rendering API from routes.predictive_search_url with section_id=predictive-search.
{% endcomment %}
{%- if predictive_search.performed -%}
  {%- liquid
    assign products = predictive_search.resources.products
    assign safe_terms = predictive_search.terms | escape
  -%}
  <div class="predictive" data-count="{{ 'search.suggestions' | t: count: products.size }}">
    {%- if products.size > 0 -%}
      <ul class="predictive__list" role="list">
        {%- for product in products -%}
          <li>
            <a class="predictive__item" href="{{ product.url }}">
              <span class="predictive__image">
                {%- if product.featured_image -%}
                  {{
                    product.featured_image
                    | image_url: width: 160
                    | image_tag: widths: '80, 160', sizes: '4rem', alt: '', loading: 'eager'
                  }}
                {%- else -%}
                  {{ 'placeholder-tee.svg' | inline_asset_content }}
                {%- endif -%}
              </span>
              <span class="predictive__text">
                <span class="predictive__title">{{ product.title | escape }}</span>
                {% render 'price', product: product %}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="predictive__empty">{{ 'search.no_results_html' | t: terms: safe_terms }}</p>
    {%- endif -%}
    <a class="predictive__all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}&amp;options%5Bprefix%5D=last">
      {{- 'search.view_all_html' | t: terms: safe_terms -}}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  /* .predictive prefix: these links sit inside the header, whose own link reset would otherwise win. */
  .predictive__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .predictive .predictive__item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }
  .predictive .predictive__item:is(:hover, :focus-visible) {
    background: var(--color-surface);
  }
  .predictive__image {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .predictive__image :is(img, svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .predictive__text {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }
  .predictive__title {
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .predictive__empty {
    padding: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .predictive .predictive__all {
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-4);
    border-block-start: 1px solid var(--color-rule);
    color: inherit;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-decoration: none;
    text-transform: uppercase;
  }
  .predictive .predictive__all:is(:hover, :focus-visible) {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search"
}
{% endschema %}
