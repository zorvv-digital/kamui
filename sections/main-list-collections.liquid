<div class="list-collections">
  <h1 class="page-title">{{ 'collections.title' | t }}</h1>

  <ul class="list-collections__grid" role="list">
    {% for collection_item in collections %}
      {% if collection_item.handle == 'frontpage' %}
        {% continue %}
      {% endif %}
      {% assign tile_image = collection_item.featured_image | default: collection_item.products.first.featured_image %}
      <li>
        <a class="collection-card" href="{{ collection_item.url }}">
          <div class="collection-card__media">
            {% if tile_image %}
              {{
                tile_image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw'
              }}
            {% else %}
              {{ 'placeholder-tee.svg' | inline_asset_content }}
            {% endif %}
          </div>
          <h2 class="collection-card__title">{{ collection_item.title | escape }}</h2>
          <p class="collection-card__count">
            {{ 'collections.product_count' | t: count: collection_item.products_count }}
          </p>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .list-collections {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-6) var(--space-section);
    text-align: center;
  }
  .list-collections__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: start;
  }
  .collection-card {
    display: grid;
    gap: var(--space-1);
    text-decoration: none;
  }
  .collection-card__media {
    aspect-ratio: 4 / 5;
    margin-block-end: var(--space-3);
    overflow: hidden;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .collection-card__media :is(img, svg) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease-out);
  }
  .collection-card__title {
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .collection-card__count {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  @media (hover: hover) and (pointer: fine) {
    .collection-card:hover :is(img, svg) {
      scale: 1.03;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": []
}
{% endschema %}
